{
  "name": "dealerhunt",
  "version": "1.0.0",
  "description": "DealerHunt — Multi-source vehicle sourcing intelligence platform",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "supabase gen types typescript --local > types/supabase.ts",
    "db:migrate": "supabase db push",
    "scraper:dev": "ts-node --project tsconfig.node.json lib/scrapers/runner.ts",
    "scraper:worker": "ts-node --project tsconfig.node.json lib/scrapers/worker.ts",
    "scraper:scheduler": "ts-node --project tsconfig.node.json lib/scrapers/scheduler.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.83",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@sentry/nextjs": "^10.59.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.0",
    "@upstash/qstash": "^2.11.1",
    "ai": "^6.0.208",
    "bull": "^4.16.3",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ioredis": "^5.4.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "next": "15.1.0",
    "p-limit": "^6.1.0",
    "p-retry": "^6.2.0",
    "playwright": "^1.48.2",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "resend": "^4.0.0",
    "stripe": "^17.3.0",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/bull": "^4.10.0",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.48",
    "supabase": "^1.207.9",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
