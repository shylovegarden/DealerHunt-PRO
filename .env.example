# ════════════════════════════════════════════════════════════
#  DealerHunt — Environment Variables
#  Copy to .env.local for dev, add to Vercel Dashboard for prod
# ════════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://dealerhunt.vercel.app
NEXT_PUBLIC_APP_NAME=DealerHunt

# ── Proxy Network (Bright Data or Oxylabs) ───────────────────
# Format: http://username:password@proxy.brightdata.com:22225
# Comma-separated for rotation
PROXY_URLS=http://user:pass@proxy1.brightdata.com:22225,http://user:pass@proxy2.brightdata.com:22225

# ── Redis (Upstash — serverless Redis, free tier available) ──
# Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN

# ── Email (Resend — free 3k emails/month) ────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# ── SMS Alerts (Twilio) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# ── Payments (Stripe) ────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── AI Scoring (OpenAI) ──────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Anti-Bot Bypass (FlareSolverr — self-hosted, free) ───────
# Docker: docker run -p 8191:8191 -d ghcr.io/flaresolverr/flaresolverr:latest
FLARESOLVERR_URL=http://localhost:8191

# ── Market Value API (Visor — free credits, or MarketCheck) ──
VISOR_API_KEY=visor_...
MARKETCHECK_API_KEY=...

# ── Scheduling / Background Jobs (Upstash QStash) ────────────
# Get from: https://console.upstash.com/qstash
QSTASH_TOKEN=...
QSTASH_CURRENT_SIGNING_KEY=...
QSTASH_NEXT_SIGNING_KEY=...

# ── Error Tracking (Sentry — free developer tier) ────────────
NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...
SENTRY_DSN=https://...@....ingest.sentry.io/...
SENTRY_ORG=your-org
SENTRY_PROJECT=dealerhunt
SENTRY_AUTH_TOKEN=sntrys_...

# ── Scraper Job Secret (protect /api/scan endpoint) ──────────
SCRAPER_API_SECRET=generate-a-random-32-char-string-here

# ── Cron Secret (Vercel Cron Jobs) ───────────────────────────
CRON_SECRET=another-random-32-char-string-here
